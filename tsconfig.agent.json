{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [
      "node"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "#shared/*": [
        "./shared/*"
      ]
    }
  },
  "include": [
    "agent/**/*.ts"
  ]
}
