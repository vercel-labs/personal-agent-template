{
  "name": "personal-agent-template",
  "version": "0.0.0",
  "description": "A durable personal AI assistant template built with Eve, Nuxt 4, and Better Auth",
  "license": "MIT",
  "author": "Hugo Richard",
  "repository": {
    "type": "git",
    "url": "https://github.com/vercel-labs/personal-agent-template"
  },
  "bugs": {
    "url": "https://github.com/vercel-labs/personal-agent-template/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.24.0",
  "type": "module",
  "imports": {
    "#*": "./agent/*"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "start": "nuxt preview",
    "typecheck": "nuxt typecheck && tsc -p tsconfig.agent.json",
    "db:generate": "nuxt db generate",
    "db:migrate": "nuxt db migrate",
    "typecheck:app": "nuxt typecheck",
    "typecheck:agent": "tsc -p tsconfig.agent.json"
  },
  "dependencies": {
    "@comark/nuxt": "^0.6.2",
    "@github-tools/eve-extension": "^0.5.1",
    "@libsql/client": "^0.17.4",
    "@nuxt/ui": "^4.11.0",
    "@nuxthub/core": "^0.10.8",
    "@shikijs/langs": "^4.4.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/connect": "2.0.1",
    "ai": "^7.0.85",
    "better-auth": "^1.7.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "eve": "^0.47.3",
    "maska": "^3.2.0",
    "nuxt": "^4.5.2",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.42",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.127",
    "@iconify-json/simple-icons": "^1.2.94",
    "@types/node": "26.4.0",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.11"
  }
}
